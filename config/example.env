# ─────────────────────────────────────────────────────────────────────────────
# AdminForge configuration — template only. Copy to ~/.config/adminforge/<env>.env
# (outside the repo) and fill in. Point at it with ADMINFORGE_ENV_FILE if elsewhere.
# Nothing tenant-specific is ever committed; the guard tests enforce this.
#
# Files are layered (packages/config): <env>.env (runtime) < <env>.admin.env (the keys marked "admin file" below;
# read only by the CLI and live tests, never by the services) < <env>.$ADMINFORGE_ENV_OVERLAY.env (per-deployment
# overrides, e.g. "host" for the systemd services' own DATABASE_URL) < process environment.
# ADMINFORGE_ENV selects <env> (default dev); ADMINFORGE_ENV_FILE points at the base file directly.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# URL engineers open in the browser (also the base for Entra redirect URIs)
PUBLIC_BASE_URL=http://localhost:5173
API_PORT=3001
# Extra origins that serve this environment (comma-separated), registered as Entra redirect URIs by provisioning —
# e.g. the host services on http://localhost:3300 next to the dev server on PUBLIC_BASE_URL
AF_REDIRECT_BASE_URLS=
# Interface the API binds to. Default 127.0.0.1 (Caddy publishes it to the LAN); set 0.0.0.0 only inside containers
API_HOST=127.0.0.1
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Proxies whose X-Forwarded-* headers are trusted: loopback (default — Caddy on this host), true, false, a hop count, or addresses/subnets
TRUST_PROXY=loopback
RATE_LIMIT_PER_MINUTE=600
# Built SPA served by the API in production (default portal/apps/web/dist)
WEB_DIST_DIR=
# Mock mode only: comma-separated portal roles for the mock user
MOCK_ROLES=
# entra | mock   (mock is refused when NODE_ENV=production; it also needs DATA_MODE=fixtures, a loopback API_HOST and
# no Read/Write/automation/runner credentials — run it with ADMINFORGE_ENV_FILE=/dev/null)
AUTH_MODE=entra
# live | fixtures   (fixtures serve synthetic data from ADMINFORGE_FIXTURES_DIR)
DATA_MODE=live
ADMINFORGE_FIXTURES_DIR=
DATABASE_URL=postgres://adminforge:CHANGE_ME@127.0.0.1:55432/adminforge
# Owner connection used only by `db:migrate`. Set it when DATABASE_URL is the services' least-privilege role
# (portal/deploy/db/create-app-role.sh writes both); empty = migrate with DATABASE_URL.
DATABASE_MIGRATION_URL=
# Dev Postgres password used by portal/deploy/docker-compose*.yml
POSTGRES_PASSWORD=
# 32 random bytes, base64:  openssl rand -base64 32
TOKEN_CACHE_KEY=
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
WRITE_SESSION_MAX_MINUTES=60
# Conditional Access authentication context for write step-up (e.g. c1; needs Entra ID P1).
# Empty = step-up uses a fresh interactive sign-in instead.
WRITE_AUTH_CONTEXT=

# ── Tenant ───────────────────────────────────────────────────────────────────
AF_TENANT_ID=
AF_PRIMARY_DOMAIN=
# Optional default subscription for Azure pages
AF_SUBSCRIPTION_ID=
# "contoso" for contoso-admin.sharepoint.com (SharePoint admin features)
AF_SPO_TENANT_NAME=
# Custom verified mail domain checked by the DNS probes (MX/SPF/DMARC/autodiscover); not the onmicrosoft.com domain
AF_MAIL_DOMAIN=
# SKU part numbers watched by the licence-seat probes (e.g. SPE_E3, SPE_E5)
AF_LICENCE_SKU_1=
AF_LICENCE_SKU_2=
# Environment label used in provisioned object names (dev, prod, …)
AF_ENV_LABEL=dev
# Default Log Analytics workspace (customer id GUID) for KQL checks, schedules and Query Studio;
# the automation identity reads it through the subscription Reader role that `provision entra` grants
# (`provision azure-test` adds Log Analytics Reader on its own test workspace). Empty = Log Analytics checks report "not configured".
AF_LOG_ANALYTICS_WORKSPACE_ID=
# Tags every Azure resource must carry (comma-separated, case-insensitive) for the required-tags check (default owner)
AF_REQUIRED_TAGS=

# ── Provisioner (bootstrap identity used only by `adminforge provision`) ─────
# Needs, only while provisioning: Global Administrator (directory roles for test identities, admin consent, app and
# group objects). For the automation identity's Azure role assignments, either Owner or — better — Role Based Access
# Control Administrator at the subscription, with a condition that it may only assign Reader and Log Analytics Reader.
# Remove its directory role and delete its client secret after setup; create a short-lived one for the next run.
# admin file: <env>.admin.env
AF_PROVISIONER_CLIENT_ID=
AF_PROVISIONER_CLIENT_SECRET=

# ── Delegated portal apps (written by `adminforge provision entra`) ──────────
AF_READ_CLIENT_ID=
AF_READ_CLIENT_SECRET=
AF_WRITE_CLIENT_ID=
AF_WRITE_CLIENT_SECRET=
# true = provisioning also grants tier-0 delegated permissions that content declares (Directory.AccessAsUser.All,
# RoleManagement.ReadWrite.Directory, Application.ReadWrite.All, AppRoleAssignment.ReadWrite.All, PIM schedules, …;
# list in portal/tools/cli/src/provision/privilege.ts). Default false: skipped and listed in the plan.
AF_ALLOW_PRIVILEGED_WRITE_SCOPES=false
# Other app ids (comma-separated) that AdminForge's own playbooks must never change — owners, credentials, consent,
# disabling. Put the provisioner's client id here: AF_PROVISIONER_CLIENT_ID lives in the admin file, which the
# services never read. The Read, Write and Automation apps are always protected.
AF_PROTECTED_APP_IDS=

# ── Automation identity for schedules on this host (written by provisioning) ─
AF_AUTOMATION_CLIENT_ID=
AF_AUTOMATION_CLIENT_SECRET=
# Preferred over the secret when set (PEM with private key). `provision entra` then registers the certificate on the
# automation app and removes its client secrets.
AF_AUTOMATION_CERT_PATH=
# true = provisioning also grants application permissions that change data when content declares them for the
# automation identity (e.g. User.ReadWrite.All). Default false: those are skipped and listed in the plan.
AF_AUTOMATION_ALLOW_WRITE_PERMISSIONS=false
# true = provisioning also grants application permissions that read personal content tenant-wide when content declares
# them for the automation identity (mail, files, sites, chats, calendars, contacts, notes, BitLocker keys, meeting
# transcripts, authentication methods; list in privilege.ts). Default false: skipped and listed in the plan.
AF_AUTOMATION_ALLOW_SENSITIVE_READS=false

# ── Content registry and outbound calls ──────────────────────────────────────
# fs = load portal/content from disk with hot reload (default outside production)
# db = serve versions published with `adminforge publish` (default in production; needs DATABASE_URL)
CONTENT_SOURCE=
# Content directory for CONTENT_SOURCE=fs and the CLI (default portal/content)
CONTENT_DIR=
# true | false — watch CONTENT_DIR and reload on change (default true in development)
CONTENT_WATCH=
# Max concurrent calls per Microsoft service (graph, arm, logAnalytics, function) from this process
OUTBOUND_CONCURRENCY=16
# Max concurrent calls per user (or the automation identity) per service
OUTBOUND_USER_CONCURRENCY=6
# Per-request timeout for outbound calls, milliseconds
OUTBOUND_TIMEOUT_MS=30000
# Largest response body accepted from Microsoft or a connection, bytes (default 67108864 = 64 MB; read streamed,
# anything larger is refused with response_too_large)
OUTBOUND_MAX_BYTES=
# Hosts (comma-separated, no https://) whose https URIs a kind: connection may use as its token audience, e.g.
# api.contoso.com. api://… app ID URIs and application ids need no entry; Microsoft first-party hosts (Graph, ARM,
# Exchange, …) are refused even when listed
AF_CONNECTION_AUDIENCE_HOSTS=
# Command palette: time box per search source (definitions, Graph, Resource Graph), milliseconds
SEARCH_TIMEOUT_MS=2500
# Report export: upper bound on rows streamed into one CSV/XLSX file
EXPORT_MAX_ROWS=100000

# ── Email and Teams delivery (scheduled reports, failure alerts, approval requests) ──
# Mailbox reports are sent from (needs an Exchange Online mailbox). The automation identity needs to send as it:
# preferably an Exchange "RBAC for Applications" role scoped to this one mailbox (docs/operations.md), leaving the
# Entra Mail.Send permission withheld; Entra Mail.Send (granted only with AF_AUTOMATION_ALLOW_WRITE_PERMISSIONS=true)
# can send as ANY mailbox. Content refers to recipients only as ${ env.X }.
AF_MAIL_SENDER=
# Keys content can name for recipients / Teams Workflows webhooks. Recipient keys must be named AF_…RECIPIENTS,
# AF_…EMAIL or AF_…ALERTS (comma/semicolon-separated addresses; content may only say ${ env.<key> }, never an
# address); webhook keys AF_…WEBHOOK. Delivery reads only these keys, and *WEBHOOK* keys are never exposed to content
# expressions:
AF_REPORT_RECIPIENTS=
AF_SCHEDULE_ALERTS=
AF_TEAMS_ALERTS_WEBHOOK=
# Who hears about new approval requests (runs and write-capable schedules): addresses and/or a Teams webhook
AF_APPROVALS_EMAIL=
AF_APPROVALS_TEAMS_WEBHOOK=

# ── Retention (days; the API applies it every 6 hours; the audit log is never purged) ──
# Finished runs with their steps and events (parked runs and "needs review" are kept)
RETENTION_RUN_DAYS=180
RETENTION_SCHEDULE_RUN_DAYS=180
RETENTION_PROBE_DAYS=35
# Scheduled report files
RETENTION_ARTIFACT_DAYS=90

# ── Scheduler (schedules on this host, R6) ───────────────────────────────────
# Run the scheduler inside the API process (development / single-process installs); otherwise run the scheduler service.
# Only one scheduler is ever active (Postgres advisory lock); others stand by.
SCHEDULER_IN_PROCESS=false
# Scheduled jobs (probe sweeps, reports, playbook runs) running at the same time
SCHEDULER_CONCURRENCY=4
# Where scheduled report files are written (<dir>/<schedule>/<timestamp>.<ext>); default ~/.local/share/adminforge/artifacts
ADMINFORGE_ARTIFACTS_DIR=

# ── Runner (PowerShell workloads) ────────────────────────────────────────────
RUNNER_URL=http://127.0.0.1:3101
# Consume playbook-run jobs inside the API process (single-process installs); otherwise run the worker service
RUN_WORKER_IN_PROCESS=false
RUN_WORKER_CONCURRENCY=4
# Shared secret between api and runner on this host (openssl rand -base64 32)
# Never used directly: request signing, the runner's signed answers and the encryption of forwarded tokens each use
# their own key derived from it (HKDF-SHA256). Change it on both sides together.
# The runner service gets only this key, from its own <env>.runner.env (portal/deploy/systemd/adminforge-runner.service)
RUNNER_SHARED_KEY=
RUNNER_HOST=127.0.0.1
RUNNER_PORT=3101
# Pre-forked single-use pwsh workers kept warm
RUNNER_POOL_SIZE=2
# Max concurrent jobs (default max(2, 2 × pool size))
RUNNER_MAX_JOBS=
# Seconds a job may wait for a free worker before 503
RUNNER_QUEUE_TIMEOUT_SECONDS=60
# Modules imported before a job arrives: comma list of graph,exchange,teams,sharepoint,az — or none
RUNNER_PRELOAD_MODULES=
# Pinned PowerShell modules (default portal/apps/runner/modules)
ADMINFORGE_RUNNER_MODULES_DIR=
# Scripts the runner may execute (default portal/content/scripts)
ADMINFORGE_SCRIPTS_DIR=
# pwsh binary (default: pwsh on PATH, then ~/.local/bin/pwsh)
PWSH_PATH=

# ── Validation (test tenants only; written by `adminforge provision test-identities`) ─
# admin file: <env>.admin.env
AF_TEST_USER_UPN=
AF_TEST_USER_PASSWORD=
# TOTP seed registered for the validation user by tests/live/scripts/register-test-user-mfa.ts (Security Defaults)
AF_TEST_USER_TOTP_SECRET=
# Environment labels (AF_ENV_LABEL, comma-separated) where test identities may exist (default dev,test). Elsewhere
# `provision test-identities` refuses and `provision status` fails if the validation user or AF-Test-* objects exist.
AF_TEST_IDENTITY_LABELS=
# Azure region for `adminforge provision azure-test` (resource group AF-Test-<label> with a capped Log Analytics
# workspace for live KQL validation; it also writes AF_LOG_ANALYTICS_WORKSPACE_ID). Default eastus.
AF_TEST_LOCATION=
