# ─────────────────────────────────────────────────────────────────────────────
# AdminForge configuration — template only. Copy to ~/.config/adminforge/<env>.env
# (outside the repo) and fill in. Point at it with ADMINFORGE_ENV_FILE if elsewhere.
# Nothing tenant-specific is ever committed; the guard tests enforce this.
#
# Files are layered (packages/config): <env>.env (runtime) < <env>.admin.env (the keys marked "admin file" below;
# read only by the CLI and live tests, never by the services) < <env>.$ADMINFORGE_ENV_OVERLAY.env (per-deployment
# overrides, e.g. "host" for the systemd services' own DATABASE_URL) < process environment.
# ADMINFORGE_ENV selects <env> (default dev); ADMINFORGE_ENV_FILE points at the base file directly.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# URL engineers open in the browser (also the base for Entra redirect URIs)
PUBLIC_BASE_URL=http://localhost:5173
API_PORT=3001
# Extra origins that serve this environment (comma-separated), registered as Entra redirect URIs by provisioning —
# e.g. the host services on http://localhost:3300 next to the dev server on PUBLIC_BASE_URL
AF_REDIRECT_BASE_URLS=
# Interface the API binds to. Default 127.0.0.1 (Caddy publishes it to the LAN); set 0.0.0.0 only inside containers
API_HOST=127.0.0.1
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Proxies whose X-Forwarded-* headers are trusted: loopback (default — Caddy on this host), true, false, a hop count, or addresses/subnets
TRUST_PROXY=loopback
# Requests per minute per signed-in session (per client address before sign-in); per-route limits count the same way
RATE_LIMIT_PER_MINUTE=600
# Requests per minute per session that the browser marks as background (polling, refetch on focus), counted apart
RATE_LIMIT_BACKGROUND_PER_MINUTE=600
# Requests per minute per client address (IPv6: per /64), all its sessions together (behind a NAT every engineer
# shares one address)
RATE_LIMIT_PER_ADDRESS_PER_MINUTE=20000
# /auth/login and /auth/callback per client address, whatever cookie comes with them (a big NAT: raise it)
RATE_LIMIT_SIGNIN_PER_ADDRESS_PER_MINUTE=300
# Requests to /api and /auth without a valid session, per client address
RATE_LIMIT_ANONYMOUS_PER_ADDRESS_PER_MINUTE=600
# Built SPA served by the API in production (default portal/apps/web/dist)
WEB_DIST_DIR=
# Mock mode only: comma-separated portal roles for the mock user
MOCK_ROLES=
# entra | mock   (mock is refused when NODE_ENV=production; it also needs DATA_MODE=fixtures, a loopback API_HOST and
# no Read/Write/automation/runner credentials — run it with ADMINFORGE_ENV_FILE=/dev/null)
AUTH_MODE=entra
# live | fixtures   (fixtures serve synthetic data from ADMINFORGE_FIXTURES_DIR)
DATA_MODE=live
ADMINFORGE_FIXTURES_DIR=
# Development: the dev database's own non-superuser owner (init:local writes it; pnpm db:harden creates the role). The
# services' overlay (<env>.host.env) points it at their least-privilege role (portal/deploy/db/create-app-role.sh).
# A database on another host needs ?sslmode=verify-full in production. Never a superuser (production refuses to start).
DATABASE_URL=postgres://adminforge_dev:CHANGE_ME@127.0.0.1:55432/adminforge_dev
# Owner connection used only by `db:migrate` (the services' database owner, a non-superuser). It belongs in the owner
# file <env>.<overlay>.owner.env, which only migrations and the database scripts read (pnpm db:harden writes it);
# empty = migrate with DATABASE_URL (development).
DATABASE_MIGRATION_URL=
# The local container's bootstrap superuser, read by compose only when it creates a new cluster. It belongs in the
# owner file <env>.owner.env (init:local writes it there); it can sign in over the container socket only, never TCP.
POSTGRES_PASSWORD=
# Connections per process pool (API, worker and scheduler each have one)
DATABASE_POOL_MAX=10
# Per-connection limits (ms): a stuck statement or open transaction can't hold the audit chain's lock for long
DATABASE_STATEMENT_TIMEOUT_MS=60000
DATABASE_LOCK_TIMEOUT_MS=15000
DATABASE_IDLE_IN_TRANSACTION_TIMEOUT_MS=60000
# 32 random bytes, base64:  openssl rand -base64 32
TOKEN_CACHE_KEY=
# After a routine rotation of TOKEN_CACHE_KEY: the earlier key(s), comma-separated, so tokens sealed before it still
# open (docs/operations.md → Postgres hardening). Remove once everyone has signed in again (at most
# SESSION_ABSOLUTE_HOURS). Never put a key here that may have leaked: rotate without it and empty the token cache.
TOKEN_CACHE_PREVIOUS_KEYS=
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
WRITE_SESSION_MAX_MINUTES=60
# Conditional Access authentication context for write step-up (e.g. c1; needs Entra ID P1).
# Empty = step-up uses a fresh interactive sign-in instead.
WRITE_AUTH_CONTEXT=

# ── Tenant ───────────────────────────────────────────────────────────────────
AF_TENANT_ID=
AF_PRIMARY_DOMAIN=
# Optional default subscription for Azure pages
AF_SUBSCRIPTION_ID=
# "contoso" for contoso-admin.sharepoint.com (SharePoint admin features)
AF_SPO_TENANT_NAME=
# Custom verified mail domain checked by the DNS probes (MX/SPF/DMARC/autodiscover); not the onmicrosoft.com domain
AF_MAIL_DOMAIN=
# SKU part numbers watched by the licence-seat probes (e.g. SPE_E3, SPE_E5)
AF_LICENCE_SKU_1=
AF_LICENCE_SKU_2=
# Environment label used in provisioned object names (dev, prod, …)
AF_ENV_LABEL=dev
# Default Log Analytics workspace (customer id GUID) for KQL checks, schedules and Query Studio;
# the automation identity reads it through the subscription Reader role that `provision entra` grants
# (`provision azure-test` adds Log Analytics Reader on its own test workspace). Empty = Log Analytics checks report "not configured".
AF_LOG_ANALYTICS_WORKSPACE_ID=
# Tags every Azure resource must carry (comma-separated, case-insensitive) for the required-tags check (default owner)
AF_REQUIRED_TAGS=

# ── Provisioner (bootstrap identity used only by `adminforge provision`) ─────
# Needs, only while provisioning: Global Administrator (directory roles for test identities, admin consent, app and
# group objects). For the automation identity's Azure role assignments, either Owner or — better — Role Based Access
# Control Administrator at the subscription, with a condition that it may only assign Reader and Log Analytics Reader.
# Remove its directory role and delete its client secret after setup; create a short-lived one for the next run.
# admin file: <env>.admin.env
AF_PROVISIONER_CLIENT_ID=
AF_PROVISIONER_CLIENT_SECRET=

# ── Delegated portal apps (written by `adminforge provision entra`) ──────────
AF_READ_CLIENT_ID=
AF_READ_CLIENT_SECRET=
AF_WRITE_CLIENT_ID=
AF_WRITE_CLIENT_SECRET=
# true = provisioning also grants tier-0 delegated permissions that content declares (Directory.AccessAsUser.All,
# RoleManagement.ReadWrite.Directory, Application.ReadWrite.All, AppRoleAssignment.ReadWrite.All, PIM schedules, …;
# list in portal/tools/cli/src/provision/privilege.ts). Default false: skipped and listed in the plan.
AF_ALLOW_PRIVILEGED_WRITE_SCOPES=false
# Other app ids (comma-separated) that AdminForge must never change — owners, credentials, consent, disabling. Every
# declared write that names the app, its app registration or its service principal is refused (protected_object). Put
# the provisioner's client id here: AF_PROVISIONER_CLIENT_ID lives in the admin file, which the services never read.
# The Read, Write and Automation apps, and every group or account holding an AdminForge app role, are always protected.
AF_PROTECTED_APP_IDS=
# Object ids (comma-separated) of break-glass / emergency-access accounts — and anyone else AdminForge must never
# change (disable, reset password or MFA, Temporary Access Pass, group membership or ownership, roles). Every declared
# write that names one of them is refused (protected_object); change them in the Microsoft Entra admin center. They
# are also excluded from the ca-audit test fixture's report-only Conditional Access policies.
AF_PROTECTED_USER_IDS=

# ── Automation identity for schedules on this host (written by provisioning) ─
AF_AUTOMATION_CLIENT_ID=
AF_AUTOMATION_CLIENT_SECRET=
# Preferred over the secret when set (PEM with private key). `provision entra` then registers the certificate on the
# automation app and removes its client secrets.
AF_AUTOMATION_CERT_PATH=
# true = provisioning also grants application permissions that change data when content declares them for the
# automation identity (e.g. User.ReadWrite.All). Default false: those are skipped and listed in the plan.
AF_AUTOMATION_ALLOW_WRITE_PERMISSIONS=false
# true = provisioning also grants application permissions that read personal content tenant-wide when content declares
# them for the automation identity (mail, files, sites, chats, calendars, contacts, notes, BitLocker keys, meeting
# transcripts, authentication methods; list in privilege.ts). Default false: skipped and listed in the plan.
AF_AUTOMATION_ALLOW_SENSITIVE_READS=false
# true = provisioning also grants tier-0 application permissions (role management, app credentials and consent grants,
# tenant policies; list in privilege.ts) when content declares them for an app-only identity. Needs
# AF_AUTOMATION_ALLOW_WRITE_PERMISSIONS=true too. Default false: an unattended identity holding them could change who
# holds privilege in the tenant.
AF_AUTOMATION_ALLOW_PRIVILEGED_PERMISSIONS=false

# ── Named app identities schedules may run as (ADR-014) ──────────────────────
# Comma-separated lower-case names (letters and digits, single dashes between), e.g. reports-team,intune-ops. Each is an
# app registration of its own that `provision entra` creates ("AdminForge Identity <name> [<label>]") with exactly the
# application permissions of the schedules naming it (`identity: { app: <name> }`), under the automation identity's
# ceilings. Any Operator can pick any listed identity for a report schedule they create in the portal (reports are
# read-only), so list only identities whose read access every Operator may use. Per name, in this file:
#   AF_IDENTITY_<NAME>_CLIENT_ID      application (client) id   (<NAME> = the name upper-cased, dashes → underscores)
#   AF_IDENTITY_<NAME>_CLIENT_SECRET  client secret, or         (provisioning writes these two)
#   AF_IDENTITY_<NAME>_CERT_PATH      PEM certificate + private key (preferred; provisioning then removes its secrets)
#   AF_IDENTITY_<NAME>_ALLOW_WRITE_PERMISSIONS / _ALLOW_SENSITIVE_READS / _ALLOW_PRIVILEGED_PERMISSIONS
#                                     true = lift that ceiling for this identity — only together with the matching
#                                     AF_AUTOMATION_ALLOW_* key above (default false). Set them in <env>.admin.env.
AF_SCHEDULE_IDENTITIES=

# ── Content registry and outbound calls ──────────────────────────────────────
# fs = load portal/content from disk with hot reload (default outside production)
# db = serve versions published with `adminforge publish` (default in production; needs DATABASE_URL)
CONTENT_SOURCE=
# Content directory for CONTENT_SOURCE=fs and the CLI (default portal/content)
CONTENT_DIR=
# true | false — watch CONTENT_DIR and reload on change (default true in development; also re-checks file stamps
# every 2 s, so a change the file watcher misses still reloads)
CONTENT_WATCH=
# Concurrent calls per Microsoft service (graph, arm, logAnalytics, function) for people, per API process. 48 stays
# within Graph's directory limit for one app in a large tenant when every slot is busy (docs/performance.md); raise
# it only while the `microsoft call` log shows no throttling
OUTBOUND_CONCURRENCY=48
# Max concurrent calls per user (or the automation identity) per service
OUTBOUND_USER_CONCURRENCY=6
# Share (0.1-1) of OUTBOUND_CONCURRENCY that crawls may hold: pages of a `paging: all` past its second page. List
# pages, entity reads and batches are served first
OUTBOUND_CRAWL_SHARE=0.5
# Concurrent calls per service for the automation identity (schedules, probes), apart from people's
OUTBOUND_AUTOMATION_CONCURRENCY=8
# Per-attempt timeout for outbound calls, milliseconds; a timed-out attempt is tried once more
OUTBOUND_TIMEOUT_MS=30000
# One longer attempt (no retry on timeout) for reads known to be slow on a big tenant: comma-separated service=ms or
# service:/path-prefix=ms (services graph, arm, logAnalytics, function; 1000-600000 ms). Empty = the default:
# logAnalytics=120000,graph:/auditLogs/=120000,graph:/reports/=120000,graph:/security/runHuntingQuery=120000
OUTBOUND_TIMEOUT_OVERRIDES=
# Longest a person waits for a free outbound slot before the request is refused as busy (503), milliseconds;
# 0 = no limit. The automation identity (schedules) always waits
OUTBOUND_QUEUE_WAIT_MS=15000
# Longest one page/dashboard/report datasource may take for a person, every page and retry included (504
# datasource_timeout), milliseconds; 0 = no limit. Exports and schedules are not cut short
DATASOURCE_DEADLINE_MS=120000
# Memory for cached datasource results per API process, megabytes (entries are also capped at 1,000)
DATASOURCE_CACHE_MAX_MB=256
# Largest response body accepted from Microsoft or a connection, bytes (default 67108864 = 64 MB; read streamed,
# anything larger is refused with response_too_large)
OUTBOUND_MAX_BYTES=
# Hosts (comma-separated, no https://) whose https URIs a kind: connection may use as its token audience, e.g.
# api.contoso.com. api://… app ID URIs and application ids need no entry; Microsoft first-party hosts (Graph, ARM,
# Exchange, …) are refused even when listed
AF_CONNECTION_AUDIENCE_HOSTS=
# Command palette: time box per search source (definitions, Graph, Resource Graph), milliseconds
SEARCH_TIMEOUT_MS=2500
# Report export: upper bound on rows streamed into one CSV/XLSX file
EXPORT_MAX_ROWS=100000
# Query Studio sources this installation offers, comma-separated: resourceGraph, logAnalytics, advancedHunting
# (Microsoft Defender XDR). Empty = all three. Query Studio only: the API refuses the others there (403 source_off)
# and the studio hides them, e.g. resourceGraph,logAnalytics where nobody works in the Defender portal. Set it in the
# env file `provision entra` reads too: the Read app gets ThreatHunting.Read.All only while advancedHunting is offered
AF_QUERY_SOURCES=

# ── Email and Teams delivery (scheduled reports, failure alerts, approval requests) ──
# Mailbox reports are sent from (needs an Exchange Online mailbox). The automation identity needs to send as it:
# preferably an Exchange "RBAC for Applications" role scoped to this one mailbox (docs/operations.md), leaving the
# Entra Mail.Send permission withheld; Entra Mail.Send (granted only with AF_AUTOMATION_ALLOW_WRITE_PERMISSIONS=true)
# can send as ANY mailbox. Content refers to recipients only as ${ env.X }.
AF_MAIL_SENDER=
# Keys content can name for recipients / Teams Workflows webhooks. Recipient keys must be named AF_…RECIPIENTS,
# AF_…EMAIL or AF_…ALERTS (comma/semicolon-separated addresses; content may only say ${ env.<key> }, never an
# address); webhook keys AF_…WEBHOOK. Delivery reads only these keys, and *WEBHOOK* keys are never exposed to content
# expressions:
AF_REPORT_RECIPIENTS=
AF_SCHEDULE_ALERTS=
AF_TEAMS_ALERTS_WEBHOOK=
# Who hears about new approval requests (runs and write-capable schedules): addresses and/or a Teams webhook
AF_APPROVALS_EMAIL=
AF_APPROVALS_TEAMS_WEBHOOK=

# ── Retention (days; the API applies it every 6 hours; the audit log is never purged) ──
# Finished runs with their steps and events (parked runs and "needs review" are kept)
RETENTION_RUN_DAYS=180
RETENTION_SCHEDULE_RUN_DAYS=180
RETENTION_PROBE_DAYS=35
# Scheduled report files
RETENTION_ARTIFACT_DAYS=90

# ── Scheduler (schedules on this host, R6) ───────────────────────────────────
# Run the scheduler inside the API process (development / single-process installs); otherwise run the scheduler service.
# Only one scheduler is ever active (Postgres advisory lock); others stand by.
SCHEDULER_IN_PROCESS=false
# Scheduled jobs (probe sweeps, reports, playbook runs) running at the same time
SCHEDULER_CONCURRENCY=4
# Where scheduled report files are written (<dir>/<schedule>/<timestamp>.<ext>); default ~/.local/share/adminforge/artifacts
ADMINFORGE_ARTIFACTS_DIR=

# ── Runner (PowerShell workloads) ────────────────────────────────────────────
RUNNER_URL=http://127.0.0.1:3101
# Consume playbook-run jobs inside the API process (single-process installs); otherwise run the worker service
RUN_WORKER_IN_PROCESS=false
RUN_WORKER_CONCURRENCY=4
# Shared secret between api and runner on this host (openssl rand -base64 32)
# Never used directly: request signing, the runner's signed answers and the encryption of forwarded tokens each use
# their own key derived from it (HKDF-SHA256). Change it on both sides together.
# The runner service gets only this key, from its own <env>.runner.env (portal/deploy/systemd/adminforge-runner.service)
RUNNER_SHARED_KEY=
RUNNER_HOST=127.0.0.1
RUNNER_PORT=3101
# Pre-forked single-use pwsh workers kept warm
RUNNER_POOL_SIZE=2
# Max concurrent jobs (default max(2, 2 × pool size))
RUNNER_MAX_JOBS=
# Seconds a job may wait for a free worker before 503
RUNNER_QUEUE_TIMEOUT_SECONDS=60
# Modules imported before a job arrives: comma list of graph,exchange,teams,sharepoint,az — or none
RUNNER_PRELOAD_MODULES=
# Pinned PowerShell modules (default portal/apps/runner/modules)
ADMINFORGE_RUNNER_MODULES_DIR=
# Scripts the runner may execute (default portal/content/scripts)
ADMINFORGE_SCRIPTS_DIR=
# pwsh binary (default: pwsh on PATH, then ~/.local/bin/pwsh)
PWSH_PATH=

# ── Validation (test tenants only; written by `adminforge provision test-identities`) ─
# admin file: <env>.admin.env
AF_TEST_USER_UPN=
AF_TEST_USER_PASSWORD=
# TOTP seed registered for the validation user by tests/live/scripts/register-test-user-mfa.ts (Security Defaults)
AF_TEST_USER_TOTP_SECRET=
# true = `provision test-identities` also gives the validation user Exchange Recipient Administrator and SharePoint
# Administrator where the tenant licenses Exchange / SharePoint, so the live suite can run the Exchange and SharePoint
# write playbooks on AF-Test-* mailboxes and sites. Both are tenant-wide service admin roles. Default false: withheld
# (listed in the plan), and removed if the validation user still holds them. Admin file only.
AF_TEST_SERVICE_ADMIN_ROLES=false
# Licensed test fixtures (opt-in; admin file only; see tests/live/README.md → Licensed test fixtures). Each needs a
# Microsoft Graph application permission on the provisioner (listed there); `--remove-fixtures` removes the opted-in
# ones, and the enterprise ones (directory … sign-ins) and the approver whether or not they are still opted in.
# A licence SKU part number (e.g. SPE_E5) that `provision test-identities` assigns to the validation user and
# AF-Test-User-01..03 (four seats). Empty: no licence fixture.
AF_TEST_LICENCE_SKU=
# Comma-separated fixtures: pim (AF-Test-User-01 and the validation user eligible for a read-only role),
# named-location (AF-Test-Location, 192.0.2.0/24, not trusted), intune (an AF-Test compliance policy and configuration
# profile assigned to AF-Test-Group-01), approver (the second validation account below), ca-audit (14 example
# Conditional Access policies "AF-Audit: …", report-only only — never enforced; device-dependent and location examples
# on AF-Test-Group-01 only, the rest on all users / admin roles / guests minus AF_PROTECTED_USER_IDS and the
# Directory Synchronization Accounts role), directory (AF-Test-User-04..12 with attributes and a manager chain,
# dynamic / nested / Microsoft 365 / empty / group-licensing groups, administrative unit AF-Test-AU-01), guest
# (AF-Test-Guest-01 invited without an email or, where Microsoft refuses, created directly; AF-Test-Guest-02
# disabled), apps (AF-Test-App-* with expiring, long-lived and many credentials, a risky and an ownerless one,
# AF-Test-SAML-01 — never granted anything), auth-methods (an SMS method with a fictitious
# number and a Temporary Access Pass), intune-more (iOS, Android, macOS compliance, an update ring, app protection),
# sign-ins (AF-Test-SignIn-01/02, for tests/live/scripts/generate-sign-ins.ts). Empty: none.
AF_TEST_FIXTURES=
# The approver account ("AF Tester 2", Portal.Reader + Playbook.Approver), written by `provision test-identities` when
# the approver fixture is on (default UPN af-approver@<AF_PRIMARY_DOMAIN>; must differ from AF_TEST_USER_UPN; refused
# where AF_AUTOMATION_ALLOW_WRITE_PERMISSIONS=true). Enabled only by `--enable --approver`. TOTP seed registered by
# `tests/live/scripts/register-test-user-mfa.ts --approver`.
AF_TEST_APPROVER_UPN=
AF_TEST_APPROVER_PASSWORD=
AF_TEST_APPROVER_TOTP_SECRET=
# The sign-ins fixture's two accounts (AF-Test-SignIn-01 signs in with MFA, -02 fails), written by
# `provision test-identities`; the TOTP seed of -01 by tests/live/scripts/generate-sign-ins.ts on its first sign-in.
AF_TEST_SIGNIN_1_UPN=
AF_TEST_SIGNIN_1_PASSWORD=
AF_TEST_SIGNIN_1_TOTP_SECRET=
AF_TEST_SIGNIN_2_UPN=
AF_TEST_SIGNIN_2_PASSWORD=
# Environment labels (AF_ENV_LABEL, comma-separated) where test identities may exist (default dev,test). Elsewhere
# `provision test-identities` refuses and `provision status` fails if the validation user, the approver or any
# AF-Test-* fixture object exists.
AF_TEST_IDENTITY_LABELS=
# Azure region for `adminforge provision azure-test` (resource group AF-Test-<label> with a capped Log Analytics
# workspace for live KQL validation; it also writes AF_LOG_ANALYTICS_WORKSPACE_ID). Default eastus.
AF_TEST_LOCATION=
