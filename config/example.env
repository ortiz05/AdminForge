# ─────────────────────────────────────────────────────────────────────────────
# AdminForge configuration — template only. Copy to ~/.config/adminforge/<env>.env
# (outside the repo) and fill in. Point at it with ADMINFORGE_ENV_FILE if elsewhere.
# Nothing tenant-specific is ever committed; the guard tests enforce this.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# URL engineers open in the browser (also the base for Entra redirect URIs)
PUBLIC_BASE_URL=http://localhost:5173
API_PORT=3001
# Interface the API binds to (127.0.0.1 on a shared host; 0.0.0.0 inside containers)
API_HOST=127.0.0.1
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# true when behind a reverse proxy (Caddy) so client IPs and https are read from X-Forwarded-*
TRUST_PROXY=false
RATE_LIMIT_PER_MINUTE=600
# Built SPA served by the API in production (default portal/apps/web/dist)
WEB_DIST_DIR=
# Mock mode only: comma-separated portal roles for the mock user
MOCK_ROLES=
# entra | mock   (mock is refused when NODE_ENV=production)
AUTH_MODE=entra
# live | fixtures   (fixtures serve synthetic data from ADMINFORGE_FIXTURES_DIR)
DATA_MODE=live
ADMINFORGE_FIXTURES_DIR=
DATABASE_URL=postgres://adminforge:CHANGE_ME@127.0.0.1:55432/adminforge
# Dev Postgres password used by portal/deploy/docker-compose*.yml
POSTGRES_PASSWORD=
# 32 random bytes, base64:  openssl rand -base64 32
TOKEN_CACHE_KEY=
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
WRITE_SESSION_MAX_MINUTES=60
# Conditional Access authentication context for write step-up (e.g. c1; needs Entra ID P1).
# Empty = step-up uses a fresh interactive sign-in instead.
WRITE_AUTH_CONTEXT=

# ── Tenant ───────────────────────────────────────────────────────────────────
AF_TENANT_ID=
AF_PRIMARY_DOMAIN=
# Optional default subscription for Azure pages
AF_SUBSCRIPTION_ID=
# "contoso" for contoso-admin.sharepoint.com (SharePoint admin features)
AF_SPO_TENANT_NAME=
# Environment label used in provisioned object names (dev, prod, …)
AF_ENV_LABEL=dev

# ── Provisioner (bootstrap identity used only by `adminforge provision`) ─────
# Needs: Application Administrator + Privileged Role Administrator (or Global Administrator)
AF_PROVISIONER_CLIENT_ID=
AF_PROVISIONER_CLIENT_SECRET=

# ── Delegated portal apps (written by `adminforge provision entra`) ──────────
AF_READ_CLIENT_ID=
AF_READ_CLIENT_SECRET=
AF_WRITE_CLIENT_ID=
AF_WRITE_CLIENT_SECRET=

# ── Automation identity for schedules on this host (written by provisioning) ─
AF_AUTOMATION_CLIENT_ID=
AF_AUTOMATION_CLIENT_SECRET=
# Preferred over the secret when set (PEM with private key)
AF_AUTOMATION_CERT_PATH=

# ── Runner (PowerShell workloads) ────────────────────────────────────────────
RUNNER_URL=http://127.0.0.1:3101
# Shared secret between api and runner on this host (openssl rand -base64 32)
RUNNER_SHARED_KEY=

# ── Forge assistant (AI drafting) ────────────────────────────────────────────
ANTHROPIC_API_KEY=
AF_AI_MODEL=claude-sonnet-5-5

# ── Validation (test tenants only; written by `adminforge provision test-identities`) ─
AF_TEST_USER_UPN=
AF_TEST_USER_PASSWORD=
