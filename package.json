{
  "name": "adminforge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5+sha512.484563d30b4c2ad27cb48aa94ff2b302dbcebc8ff6bf28816c2589886e146ce7f76f354f3bc1a438e6f5e9768c302aa0a6f7add8232903cd4cf81426cbc14d9e",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "turbo run dev --env-mode=loose --filter=@adminforge/api --filter=@adminforge/web",
    "build": "turbo run build",
    "lint": "pnpm --filter @adminforge/lint lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @adminforge/tests test",
    "test:e2e": "pnpm --filter @adminforge/tests e2e",
    "test:e2e:prod": "pnpm --filter @adminforge/tests e2e:prod",
    "test:live": "pnpm --filter @adminforge/tests live",
    "test:perf": "AF_PERF=1 pnpm --filter @adminforge/tests exec vitest run --project perf",
    "guard": "pnpm --filter @adminforge/tests guard",
    "check:bundle": "node tooling/ci/check-bundle.mjs",
    "adminforge": "tsx portal/tools/cli/src/index.ts",
    "live:verify-api": "tsx tests/live/scripts/verify-api-live.ts",
    "live:check-pages": "tsx tests/live/scripts/check-page-datasources.ts",
    "live:run-playbook": "tsx tests/live/scripts/run-playbook.ts",
    "live:run-schedule-once": "tsx tests/live/scripts/run-schedule-once.ts",
    "live:check-mail-sender": "tsx tests/live/scripts/check-mail-sender.ts",
    "onboard": "node tooling/onboard.mjs",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "turbo": "^2.11.8",
    "typescript": "^7.0.2"
  }
}
