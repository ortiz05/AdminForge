{
  "name": "@adminforge/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./tooling": "./src/tooling.ts",
    "./tooling/scheduler": "./src/tooling-scheduler.ts",
    "./src/definitions": "./src/definitions/index.ts",
    "./src/runs": "./src/runs/index.ts",
    "./src/*": "./src/*.ts"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "init:local": "tsx src/scripts/init-local.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@adminforge/config": "workspace:*",
    "@adminforge/connectors": "workspace:*",
    "@adminforge/design-tokens": "workspace:*",
    "@adminforge/engine": "workspace:*",
    "@adminforge/expressions": "workspace:*",
    "@adminforge/runner": "workspace:*",
    "@adminforge/schemas": "workspace:*",
    "@azure/identity": "^4.14.0",
    "@azure/msal-node": "^7.1.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "better-sqlite3": "^13.0.3",
    "croner": "^10.0.1",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.7",
    "jose": "^6.2.12",
    "jsonata": "^2.2.2",
    "undici": "^8.12.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsup": "^8.5.1"
  }
}
