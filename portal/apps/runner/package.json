{
  "name": "@adminforge/runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./src/*": "./src/*.ts"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "modules:install": "pwsh -NoLogo -NoProfile -NonInteractive -File scripts/install-modules.ps1"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
