# AdminForge deploy defaults: the one place for the local Postgres container's names and port.
#
# Plain KEY=value lines (no quotes, no expansions), read three ways:
#   - docker compose: `pnpm db:up` / `pnpm db:down` pass it as the first --env-file (your env file and the process
#     environment override it) to interpolate docker-compose.dev.yml;
#   - the shell scripts (backup/adminforge-backup.sh, db/create-app-role.sh) load it through lib/defaults.sh, which
#     sets only the keys the environment doesn't already set;
#   - tests/unit/deploy/deploy-defaults.test.ts checks that config/example.env, init:local and the docs agree with it.
# Changing a value here changes the container name, port or role the next `pnpm db:up` creates; existing data stays
# in the compose project's volume (adminforge-dev_pgdata).

# The container compose names `<project>-postgres-1` (project `name:` in docker-compose.dev.yml).
AF_PG_CONTAINER=adminforge-dev-postgres-1
# Superuser and database the container creates (the owner role that runs migrations).
AF_PG_USER=adminforge
AF_PG_DATABASE=adminforge
# Loopback port on the host (5432 is left to a host Postgres).
AF_PG_PORT=55432
