# AdminForge backup (database, configuration, data) — run by adminforge-backup.timer. See docs/operations.md.
# Install with `portal/deploy/install-units.sh backup` (the service, the timer and hardening.conf as its drop-in):
# docker exec (AF_UNIX to the Docker socket), pg_dump in the container, tar, gpg and shred all run within its seccomp
# filter.
[Unit]
Description=AdminForge backup
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/AdminForge/portal/deploy/backup/adminforge-backup.sh
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# Backups are encrypted: put the recipient in a drop-in (systemctl --user edit adminforge-backup.service):
#   Environment=AF_BACKUP_GPG_RECIPIENT=<key fingerprint; its private half kept off this host>
# Without one the backup fails, unless the drop-in accepts plaintext explicitly: Environment=AF_BACKUP_ALLOW_PLAINTEXT=1
NoNewPrivileges=true
UMask=0077
