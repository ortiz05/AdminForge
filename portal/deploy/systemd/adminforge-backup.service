# AdminForge backup (database, configuration, data) — run by adminforge-backup.timer. See docs/operations.md.
# Install hardening.conf as its drop-in too (adminforge-backup.service.d/hardening.conf): docker exec (AF_UNIX to the
# Docker socket), pg_dump in the container, tar, gpg and shred all run within its seccomp filter.
[Unit]
Description=AdminForge backup
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/AdminForge/portal/deploy/backup/adminforge-backup.sh
Environment=PATH=/usr/local/bin:/usr/bin:/bin
NoNewPrivileges=true
UMask=0077
