# AdminForge TLS reverse proxy (Caddy, user unit) for LAN access — see portal/deploy/README.md.
[Unit]
Description=AdminForge TLS proxy
After=network-online.target adminforge-api.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/caddy run --config %h/.config/adminforge/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
