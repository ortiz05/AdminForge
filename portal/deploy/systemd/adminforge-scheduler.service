# AdminForge scheduler (R6, ADR-011): runs content schedules on this host as the automation identity.
# User unit — install with the commands in portal/deploy/README.md. Configuration is read from
# ~/.config/adminforge/dev.env by the service itself (ADMINFORGE_ENV / ADMINFORGE_ENV_FILE pick another file),
# so no EnvironmentFile is needed. Only one scheduler is active at a time (Postgres advisory lock): a second
# copy of this unit (another host or user) is a hot standby.
[Unit]
Description=AdminForge scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The checkout location; the install command in the README rewrites %h/AdminForge to your checkout.
WorkingDirectory=%h/AdminForge/portal/apps/scheduler
ExecStart=/usr/bin/env node dist/main.js
# Node from nvm/fnm is not on the user manager's PATH: list its bin directory first if you use one.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# SIGTERM lets running jobs finish for up to 30 s, then records the rest as interrupted and releases the lock.
KillSignal=SIGTERM
TimeoutStopSec=60
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
UMask=0027

[Install]
WantedBy=default.target
