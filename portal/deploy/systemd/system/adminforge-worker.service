# AdminForge run worker (ROLE=worker) as the dedicated `adminforge` system account.
# Installed by portal/deploy/install-service-account.sh; local settings go in adminforge-worker.service.d/override.conf.
[Unit]
Description=AdminForge run worker
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=adminforge
Group=adminforge
WorkingDirectory=@OPT@/current/portal/apps/api
ExecStart=@OPT@/runtime/node/bin/node dist/worker.js
Environment=HOME=@VARLIB@/home
Environment=PATH=@OPT@/runtime/node/bin:/usr/local/bin:/usr/bin:/bin
Environment=ADMINFORGE_ENV_FILE=@ETC@/@ENV@.env
Environment=ADMINFORGE_ARTIFACTS_DIR=@VARLIB@/artifacts
TimeoutStopSec=60
Restart=on-failure
RestartSec=5
@HARDENING@
StateDirectory=adminforge
StateDirectoryMode=0750
NoExecPaths=@VARLIB@
SocketBindDeny=any

[Install]
WantedBy=multi-user.target
